# Copy this file to .env. Never commit the real .env file.
WORDPRESS_DB_NAME=mags_school
WORDPRESS_DB_USER=mags_wp
WORDPRESS_DB_PASSWORD=replace-with-a-32-character-random-password
MARIADB_ROOT_PASSWORD=replace-with-a-different-32-character-random-password
WORDPRESS_TABLE_PREFIX=wp_
# Bind locally in development. In production, terminate HTTPS at a reverse proxy and keep this private.
WP_HTTP_BIND=127.0.0.1:8080
WP_ENVIRONMENT_TYPE=development
WORDPRESS_DEBUG=0
# Pin this to a reviewed, supported official WordPress PHP image before production deployment.
WORDPRESS_IMAGE=wordpress:php8.3-apache
